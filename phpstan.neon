parameters:
    # Nivel más estricto de análisis (max 9)
    level: 8
    
    paths:
        - src
        - tests
    
    excludePaths:
        - src/Infrastructure/Persistence/Migrations/*
        - tests/coverage/*
    
    # Configuración estricta para DDD
    checkMissingIterableValueType: true
    checkGenericClassInNonGenericObjectType: true
    checkUninitializedProperties: true
    checkImplicitMixed: true
    checkBenevolentUnionTypes: true
    
    # Reglas para código limpio
    treatPhpDocTypesAsCertain: false
    rememberPossiblyImpureFunctionValues: false
    checkThisOnly: true
    
    # Reglas específicas para DDD
    checkFunctionNameCase: true
    checkInternalClassCaseSensitivity: true
    
    # Detección de código muerto y problemas
    reportMaybesInMethodSignatures: true
    reportStaticMethodSignatures: true
    reportUnmatchedIgnoredErrors: false
    
    # Reglas para mejorar la calidad
    polluteScopeWithLoopInitialAssignments: false
    polluteScopeWithAlwaysIterableForeach: false

    
    # Ignorar errores específicos que son falsos positivos o aceptables en el contexto
    ignoreErrors:
        # Permitir inyección de dependencias en constructores privados
        - '#Constructor of class [a-zA-Z0-9\\_]+ has parameter \$[a-zA-Z0-9_]+ with default value.#'
        # Ignorar errores de tipos en value objects (son seguros por diseño)
        - '#Call to an undefined method [a-zA-Z0-9\\_]+::(value|equals)\(\)#'
        # Permitir uso de mixed en repositorios (necesario para flexibilidad)
        - '#Method [a-zA-Z0-9\\_]+Repository::(find|search|get)[a-zA-Z0-9]*\(\) should return [a-zA-Z0-9\\_]+ but returns mixed#'
        # Ignorar errores de PHPUnit
        - '#Dynamic call to static method PHPUnit\\Framework\\Assert::#'
        # Ignorar propiedades no inicializadas en clases de prueba
        - '#Class Tests\\[a-zA-Z0-9\\_]+ has an uninitialized property#'
        # Ignorar errores con empty()
        - '#Construct empty\(\) is not allowed#'
        # Ignorar errores con is_string cuando está en PHPDoc
        - '#Call to function is_string\(\) with string will always evaluate to true#'
        # Ignorar errores con tipos ternarios en repositorios
        - '#Only booleans are allowed in (a|an) (if condition|ternary operator condition)#'
        # Ignorar errores con tipos en controllers
        - '#Parameter \#\d+ \$[a-zA-Z0-9_]+ of class [a-zA-Z0-9\\_]+ constructor expects [a-zA-Z0-9\\_]+, mixed given#'
        # Ignorar errores con métodos sin tipo de retorno en controllers
        - '#Method [a-zA-Z0-9\\_]+Controller::[a-zA-Z0-9_]+\(\) has no return type specified#'
        # Ignorar parámetros sin tipos en arrays
        - '#parameter \$[a-zA-Z0-9_]+ with no value type specified in iterable type array#'
        # Ignorar errores con instanciación de clases abstractas en contenedores
        - '#Instantiated class [a-zA-Z0-9\\_]+ is abstract#'

includes:
    # Incluir reglas estrictas adicionales
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - vendor/phpstan/phpstan-deprecation-rules/rules.neon
